  "_surname_note": "称谓正则以姓氏白名单为锚，而非 [\\u4e00-\\u9fa5]。用通配汉字会把「小心」「老板」「总是」全部误命中，而用否定后顾（?![\\u4e00-\\u9fa5]）又会漏掉「张总在」「小李说」这类后接汉字的真实用例。白名单覆盖约 110 个高频姓氏（>95% 人口），复姓（欧阳、司马等）暂未覆盖。",
  "patterns": [
    {
      "regex": "[李王张刘陈杨黄赵吴周徐孙马朱胡郭何高林罗郑梁谢宋唐许韩冯邓曹彭曾肖田董袁潘于蒋蔡余杜叶程苏魏吕丁任沈姚卢姜崔钟谭陆汪范金石廖贾夏韦付方白邹孟熊秦邱江尹薛闫段雷侯龙史陶黎贺顾毛郝龚邵万钱严覃武戴莫孔向汤](总|董事长|董|总监|经理|主任|处长|科长|局长|书记|工程师|工|教授|律师|医生)",
      "class": "HIERARCHY",
      "strength": 4,
      "gloss": "职衔称谓：姓氏 + 职位，指向管理层；英译为 Mr./Ms. + 姓后位阶信息完全丢失"
    },
    {
      "regex": "小[李王张刘陈杨黄赵吴周徐孙马朱胡郭何高林罗郑梁谢宋唐许韩冯邓曹彭曾肖田董袁潘蒋蔡余杜叶程苏魏吕丁任沈姚卢姜崔钟谭陆汪范金石廖贾夏韦付方白邹孟熊秦邱江尹薛闫段雷侯龙史陶黎贺顾毛郝龚邵万钱严覃武戴莫孔向汤]",
      "class": "HIERARCHY",
      "strength": 4,
      "gloss": "「小X」称谓：用于年轻或资历浅者，只能由上级/年长者使用，单向不可逆；与「X总」并置时位阶落差即是压力本身"
    },
    {
      "regex": "老[李王张刘陈杨黄赵吴周徐孙朱胡郭何高林罗郑梁谢宋唐许韩冯邓曹彭曾肖袁潘蒋蔡余杜叶程苏魏吕任沈姚卢姜崔钟谭陆汪范金石廖贾夏韦方白邹孟熊秦邱尹薛段雷侯龙史陶黎贺顾毛郝龚邵钱覃武戴莫孔汤]",
      "class": "HIERARCHY",
      "strength": 3,
      "gloss": "「老X」称谓：用于年长或资深者，表示亲近且承认资历；平辈或下对上使用"
    },
    {
      "regex": "[李王张刘陈杨黄赵吴周徐孙马朱胡郭何高林罗郑梁谢宋唐许韩冯邓曹彭曾肖田董袁潘于蒋蔡余杜叶程苏魏吕丁任沈姚卢姜崔钟谭陆汪范金石廖贾夏韦付方白邹孟熊秦邱江尹薛闫段雷侯龙史陶黎贺顾毛郝龚邵万钱严覃武戴莫孔向汤](老师|师傅|师父|总监)",
      "class": "HIERARCHY",
      "strength": 3,
      "gloss": "「X老师」非教师义，泛用于表示专业尊重；「X师傅」为技艺或服务业敬称"
    },
    {
      "regex": "(贵|您)(司|公司|方|校|厂|刊)",
      "class": "FACE",
      "strength": 3,
      "gloss": "敬称对方机构，标记正式商务距离"
    },
    {
      "regex": "(表|堂)(哥|弟|姐|妹)",
      "class": "PRESUPPOSITION",
      "strength": 4,
      "gloss": "父系/母系亲属精确区分；英语只有 cousin，关系信息必然丢失"
    },
    {
      "regex": "(大|二|三|小)(舅|姨|叔|姑|伯)",
      "class": "PRESUPPOSITION",
      "strength": 4,
      "gloss": "排行 + 亲属位；英语无对应，排行与父母系归属同时丢失"
    },
    {
      "regex": "(出发点|方向|想法|思路)(是|都)(好|对|不错)",
      "class": "FACE",
      "strength": 5,
      "gloss": "先扬后抑结构的「扬」部分，后面必有实质否定"
    },
    {
      "regex": "(不过|只是|就是|但是)[^。！？]{0,30}(细节|问题|地方|难度|情况)",
      "class": "SUBTEXT",
      "strength": 4,
      "gloss": "先扬后抑结构的「抑」部分，此处才是真实态度"
    }
  ]
}
