  "_meta": {
    "class": "SUBTEXT",
    "version": "1.0.0",
    "description": "缓冲语与潜台词标记。strength 1-5 表示「字面义与实际义背离」的强度，5 = 字面肯定实为否定。",
    "fields": {
      "term": "字面匹配串",
      "strength": "1-5，越高背离越强",
      "literal": "外人按字面读到什么",
      "intended": "圈内人实际读到什么",
      "tags": "rejection=拒绝 | deferral=搁置 | conditional=有条件 | nonconformity=不满 | closing=结束信号 | noncommittal=不承诺"
    },
    "see": "reference/02-diagnostic-taxonomy.md#subtext--潜台词"
  },
